#!/usr/bin/env bash
set -euo pipefail

# Block rebases of protected branches.
#
# Why: protected branches should stay fast-forwarded to their upstream branch.
# Rebase task branches instead of rewriting shared release branches.
#
# This hook fires for `git rebase` and `git pull --rebase`.
#
# Recover with:    git rebase --abort   (if mid-rebase)
#                  git fetch origin <branch>
#                  git reset --hard origin/<branch>     (or just: snm)
#
# Bypass (rare):   temporarily disable the hook or rename it. `git rebase`
#                  has no --no-verify flag.

# pre-rebase args: $1 = upstream, $2 = (optional) branch being rebased.
rebased_branch="${2:-$(git symbolic-ref --short HEAD 2>/dev/null || true)}"

case "$rebased_branch" in
  dev|main)
    cat >&2 <<EOF
[pre-rebase] ERROR: refusing to rebase '$rebased_branch'.

Protected branches should stay fast-forwarded to origin/$rebased_branch.
Rebase a task branch instead of rewriting this branch.

Sync correctly:
  git fetch origin $rebased_branch
  git reset --hard origin/$rebased_branch

EOF
    exit 1
    ;;
esac

exit 0
