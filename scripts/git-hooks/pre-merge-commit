#!/usr/bin/env bash
set -euo pipefail

# Block merge commits on protected branches.
#
# Why: the no-mistakes daemon rewrites origin/<branch> on every gate cycle.
# Any "diverged" state you see between local and origin is content-duplicate,
# not a real divergence. Merging produces a conflict storm and duplicate work.
#
# Recover with:    git merge --abort
#                  git fetch origin <branch>
#                  git reset --hard origin/<branch>     (or just: snm)
#
# Bypass (rare):   git commit --no-verify

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"

case "$branch" in
  dev|main)
    cat >&2 <<EOF
[pre-merge-commit] ERROR: refusing to create a merge commit on '$branch'.

The no-mistakes daemon rewrites origin/$branch on every gate cycle, so the
divergence you saw is content-duplicate, not real divergence.

Recover:
  git merge --abort
  git fetch origin $branch
  git reset --hard origin/$branch

Or run: snm (post-gate auto-sync helper)
Bypass intentionally: git commit --no-verify
EOF
    exit 1
    ;;
esac

exit 0
