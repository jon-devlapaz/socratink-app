#!/usr/bin/env bash
set -euo pipefail

# Block merge commits on protected branches.
#
# Why: protected branches should stay fast-forwarded to their upstream branch.
# Merge commits here hide branch hygiene problems and make release history noisy.
#
# Recover with:    git merge --abort
#                  git fetch origin <branch>
#                  git reset --hard origin/<branch>
#
# Bypass (rare):   git commit --no-verify

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"

case "$branch" in
  dev|main)
    cat >&2 <<EOF
[pre-merge-commit] ERROR: refusing to create a merge commit on '$branch'.

Protected branches should stay fast-forwarded to origin/$branch.
Inspect divergence before creating a merge commit.

Recover:
  git merge --abort
  git fetch origin $branch
  git reset --hard origin/$branch

Bypass intentionally: git commit --no-verify
EOF
    exit 1
    ;;
esac

exit 0
