#!/usr/bin/env bash
# Raw `git push` requires the one-shot authorization payload written by
# scripts/agent-push.py.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
auth_path="${SOCRATINK_PUSH_AUTH_PATH:-$repo_root/.agents/runtime/push-auth.json}"
remote_name="${1:-}"
remote_url="${2:-}"
pre_push_updates="$(cat)"

if [ ! -f "$auth_path" ]; then
  echo "[pre-push] ERROR: push not authorized. Use scripts/agent-push.py." >&2
  exit 1
fi

trap 'rm -f "$auth_path"' EXIT

SOCRATINK_PRE_PUSH_UPDATES="$pre_push_updates" python3 - "$auth_path" "$remote_name" "$remote_url" <<'PY'
import json
import os
import subprocess
import sys
from pathlib import Path


auth_path = Path(sys.argv[1])
remote_name = sys.argv[2]
remote_url = sys.argv[3]
payload = json.loads(auth_path.read_text(encoding="utf-8"))

route = payload["route"]
expected_url = payload["remote_url"]
expected_refspec = payload["refspec"]
expected_branch = payload["branch"]
expected_head = payload["head_sha"]

if route.startswith("origin/"):
    expected_remote = "origin"
else:
    print(f"[pre-push] ERROR: unsupported authorized route {route!r}", file=sys.stderr)
    raise SystemExit(1)

if remote_name != expected_remote:
    print(
        f"[pre-push] ERROR: authorized remote is {expected_remote!r}, got {remote_name!r}",
        file=sys.stderr,
    )
    raise SystemExit(1)

if remote_url != expected_url:
    print("[pre-push] ERROR: remote URL does not match authorization", file=sys.stderr)
    raise SystemExit(1)

updates = [
    line.split()
    for line in os.environ.get("SOCRATINK_PRE_PUSH_UPDATES", "").splitlines()
    if line.strip()
]
for update in updates:
    if len(update) < 4:
        print("[pre-push] ERROR: malformed pre-push update", file=sys.stderr)
        raise SystemExit(1)
    local_ref, local_sha, remote_ref, _remote_sha = update[:4]
    expected_remote_ref = f"refs/heads/{expected_refspec}"
    if remote_ref != expected_remote_ref:
        print(
            f"[pre-push] ERROR: authorized destination is {expected_remote_ref}, got {remote_ref}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    if local_sha != expected_head:
        print("[pre-push] ERROR: local SHA does not match authorization", file=sys.stderr)
        raise SystemExit(1)
    if local_ref != f"refs/heads/{expected_branch}":
        print("[pre-push] ERROR: local branch does not match authorization", file=sys.stderr)
        raise SystemExit(1)

if os.environ.get("SOCRATINK_PUSH_SKIP_GIT_HEAD") != "1":
    current_branch = subprocess.check_output(
        ["git", "symbolic-ref", "--short", "HEAD"], text=True
    ).strip()
    current_head = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    if current_branch != expected_branch:
        print("[pre-push] ERROR: current branch does not match authorization", file=sys.stderr)
        raise SystemExit(1)
    if current_head != expected_head:
        print("[pre-push] ERROR: current HEAD does not match authorization", file=sys.stderr)
        raise SystemExit(1)
PY

exit 0
