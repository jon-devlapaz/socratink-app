{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "{public/**,app_prompts/**}",
      "excludeFiles": "{tests/**,docs/**,tmp/**,scripts/**,db/**,.*/**,agents/**,node_modules/**,package*.json,*.ini,*.md,*.yaml,*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}