{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "{public/**,app_prompts/**,lib/**,bridge.py,bridge_lib/**,vendor/python/**,pedagogical_agents/**,learning_cases/**,loop-server.mjs,prompt_templates.py}",
      "excludeFiles": "{tests/**,docs/**,logs/**,tmp/**,scripts/**,db/**,.*/**,.env*,agents/**,node_modules/**,package*.json,*.ini,*.md,*.yaml}"
    },
    "api/internal-loop.mjs": {
      "includeFiles": "{lib/**,bridge.py,bridge_lib/**,vendor/python/**,pedagogical_agents/**,learning_cases/**,loop-server.mjs,prompt_templates.py}",
      "excludeFiles": "{tests/**,docs/**,logs/**,tmp/**,scripts/**,db/**,.*/**,.env*,agents/**,node_modules/**,*.ini,*.md,*.yaml}"
    }
  },
  "rewrites": [
    {
      "source": "/loop",
      "destination": "/api/index.py"
    },
    {
      "source": "/loop/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/internal-loop/:path*",
      "destination": "/api/internal-loop?path=:path*"
    },
    {
      "source": "/session/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
